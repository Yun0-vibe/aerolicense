generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: @map / @@map keep the physical tables/columns in snake_case
// to match the raw SQL queries in lib/db.ts.

model Product {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  version     String?
  apiKey      String    @unique @map("api_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  tiers       Tier[]
  licenses    License[]

  @@map("products")
}

model Tier {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  priceMonthly   Int      @map("price_monthly")
  priceYearly    Int      @map("price_yearly")
  maxIps         Int      @default(1) @map("max_ips")
  maxActivations Int      @default(1) @map("max_activations")
  features       Json
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  subscriptions  Subscription[]

  @@unique([productId, slug])
  @@map("tiers")
}

model Customer {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  company       String?
  discordId     String?  @map("discord_id")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  subscriptions Subscription[]
  orders        Order[]

  @@map("customers")
}

model Subscription {
  id                   String   @id @default(uuid())
  customerId           String   @map("customer_id")
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tierId               String   @map("tier_id")
  tier                 Tier     @relation(fields: [tierId], references: [id])
  status               String   @default("active")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  startedAt            DateTime @default(now()) @map("started_at")
  expiresAt            DateTime? @map("expires_at")
  autoRenew            Boolean  @default(true) @map("auto_renew")
  createdAt            DateTime @default(now()) @map("created_at")
  licenses             License[]

  @@map("subscriptions")
}

model License {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  licenseKey     String   @unique @map("license_key")
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id])
  tierId         String   @map("tier_id")
  status         String   @default("active")
  maxIps         Int      @default(1) @map("max_ips")
  features       Json
  tierName       String   @map("tier_name")
  createdAt      DateTime @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")
  revokeReason   String?  @map("revoke_reason")
  activations    Activation[]

  @@map("licenses")
}

model Activation {
  id                 String   @id @default(uuid())
  licenseId          String   @map("license_id")
  license            License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  ipAddress          String   @map("ip_address")
  hostname           String?
  machineFingerprint String?  @map("machine_fingerprint")
  activatedAt        DateTime @default(now()) @map("activated_at")
  lastSeenAt         DateTime @default(now()) @map("last_seen_at")
  isActive           Boolean  @default(true) @map("is_active")

  @@unique([licenseId, ipAddress])
  @@map("activations")
}

model Order {
  id              String   @id @default(uuid())
  customerId      String   @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id])
  tierId          String   @map("tier_id")
  amount          Int
  status          String   @default("pending")
  stripeSessionId String?  @map("stripe_session_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("orders")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("admin_users")
}
